@model EmployeeDeskBooking.Web.Areas.Admin.Models.AdminBookingsViewModel
@using EmployeeDeskBooking.Domain.Bookings
@{
    ViewData["Title"] = "All Bookings";
    Layout = "_Layout";
}

<div class="page-header">
    <h1>All Bookings</h1>
    <p class="text-muted">View and manage desk bookings across all employees.</p>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success" role="status" aria-live="polite">@Model.SuccessMessage</div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-error" role="alert">@Model.ErrorMessage</div>
}

<div class="page-card">
    <form asp-action="ApplyFilters" method="post" class="date-filter-form admin-filter-form">
        @Html.AntiForgeryToken()
        <div class="field inline-field">
            <label for="filterDate">Date</label>
            <input id="filterDate" name="filterDate" type="date"
                   value="@(Model.FilterDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="field inline-field">
            <label for="filterStatus">Status</label>
            <select id="filterStatus" name="filterStatus">
                <option value="">All</option>
                <option value="0" selected="@(Model.FilterStatus == BookingStatus.Confirmed ? "selected" : null)">Confirmed</option>
                <option value="1" selected="@(Model.FilterStatus == BookingStatus.Cancelled ? "selected" : null)">Cancelled</option>
                <option value="2" selected="@(Model.FilterStatus == BookingStatus.Completed ? "selected" : null)">Completed</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Apply filters</button>
        @if (Model.FiltersApplied)
        {
            <a asp-action="Index" class="btn btn-secondary">Clear filters</a>
        }
    </form>
</div>

@if (Model.Bookings.Count == 0)
{
    <div class="page-card empty-state">
        @if (Model.FiltersApplied)
        {
            <p>No bookings match the selected filters.</p>
            <a asp-action="Index" class="btn btn-secondary">Clear filters</a>
        }
        else
        {
            <p>No bookings have been created yet.</p>
        }
    </div>
}
else
{
    <div class="page-card desk-table-card">
        <table class="desk-table bookings-table admin-bookings-table">
            <thead>
                <tr>
                    <th scope="col">Date</th>
                    <th scope="col">Employee</th>
                    <th scope="col">Desk</th>
                    <th scope="col">Status</th>
                    <th scope="col">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.Bookings)
                {
                    <tr>
                        <td>@booking.BookingDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <span class="employee-name">@booking.EmployeeName</span>
                            <span class="employee-email text-muted">@booking.EmployeeEmail</span>
                        </td>
                        <td>@booking.DeskNumber</td>
                        <td>
                            <span class="status-pill status-@booking.StatusLabel.ToLowerInvariant()">
                                <span class="status-icon" aria-hidden="true">●</span>
                                @booking.StatusLabel
                            </span>
                        </td>
                        <td>
                            @if (booking.CanCancel)
                            {
                                <form asp-action="Cancel" method="post" class="inline-form"
                                      onsubmit="return confirm('Cancel booking for @booking.EmployeeEmail on @booking.BookingDate.ToString("dd MMM yyyy")?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="bookingId" value="@booking.BookingId" />
                                    <input type="hidden" name="filterDate" value="@Model.FilterDate?.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="filterStatus" value="@Model.FilterStatus" />
                                    <button type="submit" class="btn btn-secondary btn-sm">Cancel</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
