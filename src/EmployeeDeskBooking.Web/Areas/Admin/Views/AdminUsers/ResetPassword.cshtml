@model EmployeeDeskBooking.Web.Areas.Admin.Models.AdminResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
    Layout = "_Layout";
}

<div class="page-header reset-password-header">
    <h1>Reset password</h1>
    <p class="text-muted">
        Set a new password for <strong>@Model.Name</strong> (@Model.Email).
    </p>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-error" role="alert">@Model.ErrorMessage</div>
}

<div class="page-card reset-password-card">
    <form asp-action="ResetPassword" method="post" class="reset-password-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="userId" value="@Model.UserId" />

        <div class="field">
            <label for="newPassword">New password</label>
            <input id="newPassword" name="newPassword" type="password" autocomplete="new-password" required />
        </div>

        <div class="field">
            <label for="confirmPassword">Confirm password</label>
            <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required />
        </div>

        <div class="reset-password-actions">
            <a asp-action="Index" class="reset-password-back-link">← Back to users</a>
            <button type="submit" class="btn btn-primary btn-reset-password">Reset password</button>
        </div>
    </form>
</div>
