@model EmployeeDeskBooking.Web.Areas.Admin.Models.AdminDesksViewModel
@using EmployeeDeskBooking.Domain.Desks
@{
    ViewData["Title"] = "Manage desks";
    Layout = "_Layout";
}

<div class="page-header desk-page-header">
    <div>
        <h1>Manage desks</h1>
        <p class="text-muted">Add, edit, or deactivate desk inventory.</p>
    </div>
    <details class="desk-add-details">
        <summary class="btn btn-primary btn-add-desk">+ Add desk</summary>
        <div class="desk-add-panel">
            <form asp-action="Create" method="post" class="desk-add-form">
                @Html.AntiForgeryToken()
                <div class="field inline-field">
                    <label for="deskNumber">Desk number</label>
                    <input id="deskNumber" name="deskNumber" type="text" maxlength="32" required placeholder="e.g. A-01" />
                </div>
                <div class="field inline-field">
                    <label for="location">Location</label>
                    <input id="location" name="location" type="text" maxlength="100" placeholder="e.g. Floor 1, Zone C" />
                </div>
                <button type="submit" class="btn btn-primary">Save desk</button>
            </form>
        </div>
    </details>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success" role="status" aria-live="polite">@Model.SuccessMessage</div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-error" role="alert">@Model.ErrorMessage</div>
}

@if (Model.Desks.Count == 0)
{
    <div class="page-card empty-state">
        <p>No desks in the inventory yet. Click <strong>+ Add desk</strong> to create one.</p>
    </div>
}
else
{
    <div class="page-card desk-table-card">
        <table class="desk-table admin-desks-table">
            <thead>
                <tr>
                    <th scope="col">Desk</th>
                    <th scope="col">Location</th>
                    <th scope="col">Status</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var desk in Model.Desks)
                {
                    <tr>
                        <td class="desk-id">@desk.DeskNumber</td>
                        <td class="desk-location text-muted">@desk.Location</td>
                        <td>
                            <span class="status-pill status-@desk.StatusLabel.ToLowerInvariant()">
                                <span class="status-icon" aria-hidden="true">●</span>
                                @desk.StatusLabel
                            </span>
                        </td>
                        <td class="desk-actions">
                            <div class="desk-row-actions">
                                <details class="desk-edit-details">
                                    <summary class="desk-action-link">Edit</summary>
                                    <form asp-action="Edit" method="post" class="desk-edit-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="deskId" value="@desk.DeskId" />
                                        <label class="sr-only" for="edit-number-@desk.DeskId">Desk number</label>
                                        <input id="edit-number-@desk.DeskId" name="deskNumber" type="text"
                                               value="@desk.DeskNumber" maxlength="32" required />
                                        <label class="sr-only" for="edit-location-@desk.DeskId">Location</label>
                                        <input id="edit-location-@desk.DeskId" name="location" type="text"
                                               value="@desk.Location" maxlength="100" placeholder="Location" />
                                        <button type="submit" class="btn btn-primary btn-sm">Save</button>
                                    </form>
                                </details>
                                @if (desk.Status == DeskStatus.Active)
                                {
                                    if (desk.CanDeactivate)
                                    {
                                        <form asp-action="Deactivate" method="post" class="inline-form"
                                              onsubmit="return confirm('Deactivate desk @desk.DeskNumber?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="deskId" value="@desk.DeskId" />
                                            <button type="submit" class="desk-action-link">Deactivate</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="desk-action-link desk-action-disabled" title="Cancel future bookings in All Bookings first">
                                            Deactivate
                                        </span>
                                    }
                                }
                                else
                                {
                                    <form asp-action="Activate" method="post" class="inline-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="deskId" value="@desk.DeskId" />
                                        <button type="submit" class="desk-action-link">Activate</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
