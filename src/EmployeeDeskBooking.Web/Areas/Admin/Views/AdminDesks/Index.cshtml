@model EmployeeDeskBooking.Web.Areas.Admin.Models.AdminDesksViewModel
@using EmployeeDeskBooking.Domain.Desks
@{
    ViewData["Title"] = "Manage Desks";
    Layout = "_Layout";
}

<div class="page-header desk-page-header">
    <div>
        <h1>Manage desks</h1>
        <p class="text-muted">Add, edit, and activate or deactivate desks in the office inventory.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success" role="status" aria-live="polite">@Model.SuccessMessage</div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-error" role="alert">@Model.ErrorMessage</div>
}

<div class="page-card">
    <h2 class="section-title">Add desk</h2>
    <form asp-action="Create" method="post" class="desk-add-form">
        @Html.AntiForgeryToken()
        <div class="field inline-field">
            <label for="deskNumber">Desk number</label>
            <input id="deskNumber" name="deskNumber" type="text" maxlength="32" required />
        </div>
        <button type="submit" class="btn btn-primary">Add desk</button>
    </form>
</div>

@if (Model.Desks.Count == 0)
{
    <div class="page-card empty-state">
        <p>No desks in the inventory yet.</p>
    </div>
}
else
{
    <div class="page-card desk-table-card">
        <table class="desk-table admin-desks-table">
            <thead>
                <tr>
                    <th scope="col">Desk</th>
                    <th scope="col">Status</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var desk in Model.Desks)
                {
                    <tr>
                        <td>
                            <form asp-action="Edit" method="post" class="inline-form desk-edit-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="deskId" value="@desk.DeskId" />
                                <label class="sr-only" for="edit-@desk.DeskId">Desk number</label>
                                <input id="edit-@desk.DeskId" name="deskNumber" type="text"
                                       value="@desk.DeskNumber" maxlength="32" required />
                                <button type="submit" class="btn btn-secondary btn-sm">Save</button>
                            </form>
                        </td>
                        <td>
                            <span class="status-pill status-@desk.StatusLabel.ToLowerInvariant()">
                                <span class="status-icon" aria-hidden="true">●</span>
                                @desk.StatusLabel
                            </span>
                        </td>
                        <td class="desk-actions">
                            @if (desk.Status == DeskStatus.Active)
                            {
                                if (desk.CanDeactivate)
                                {
                                    <form asp-action="Deactivate" method="post" class="inline-form"
                                          onsubmit="return confirm('Deactivate desk @desk.DeskNumber?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="deskId" value="@desk.DeskId" />
                                        <button type="submit" class="btn btn-secondary btn-sm">Deactivate</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted desk-blocked-hint" title="Cancel future bookings first">
                                        Deactivate blocked
                                    </span>
                                }
                            }
                            else
                            {
                                <form asp-action="Activate" method="post" class="inline-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="deskId" value="@desk.DeskId" />
                                    <button type="submit" class="btn btn-secondary btn-sm">Activate</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
