{
  "Database": {
    "Provider": "InMemory"
  },
  "Office": {
    "TimeZone": "India Standard Time"
  },
  "Smtp": {
    "Enabled": false,
    "Mode": "FileDrop"
  },
  "Vapid": {
    "Enabled": false
  },
  "ReminderJob": {
    "Enabled": false
  },
  "Seed": {
    "Mode": "Json",
    "DatasetPath": "data/dataset.json",
    "JsonReplaceExisting": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
