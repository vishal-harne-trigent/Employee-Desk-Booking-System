{
  "Database": {
    "Provider": "SqlServer"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=EmployeeDeskBooking;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Office": {
    "TimeZone": "India Standard Time"
  },
  "Smtp": {
    "Enabled": false,
    "Mode": "FileDrop",
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UseSsl": true,
    "FromName": "Desk Booking System",
    "FromAddress": "noreply@deskbooking.local"
  },
  "Vapid": {
    "Enabled": false
  },
  "Push": {
    "Enabled": false
  },
  "ReminderJob": {
    "Enabled": true,
    "RunAtLocalTime": "08:00"
  },
  "Seed": {
    "Mode": "Json",
    "DatasetPath": "data/dataset.json",
    "JsonOnlyIfEmpty": true,
    "JsonReplaceExisting": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  }
}
