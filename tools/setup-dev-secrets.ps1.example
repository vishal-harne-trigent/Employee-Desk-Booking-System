# Copy to setup-dev-secrets.ps1, fill in values, run once per machine.
# Secrets are stored outside the repo via dotnet user-secrets.

$Root = Split-Path $PSScriptRoot -Parent
$Api = Join-Path $Root "src\EmployeeDeskBooking.Api"
$Web = Join-Path $Root "src\EmployeeDeskBooking.Web"

# API — JWT + SMTP
dotnet user-secrets set "Jwt:SigningKey" "YOUR_DEV_JWT_SIGNING_KEY_MIN_32_CHARS" --project $Api
dotnet user-secrets set "Email:Enabled" "true" --project $Api
dotnet user-secrets set "Email:FromAddress" "your-mailbox@gmail.com" --project $Api
dotnet user-secrets set "Email:Username" "your-mailbox@gmail.com" --project $Api
dotnet user-secrets set "Email:Password" "YOUR_GMAIL_APP_PASSWORD" --project $Api
dotnet user-secrets set "Smtp:Username" "your-mailbox@gmail.com" --project $Api
dotnet user-secrets set "Smtp:Password" "YOUR_GMAIL_APP_PASSWORD" --project $Api

# Web — SMTP (same mailbox as API for local dev)
dotnet user-secrets set "Smtp:Enabled" "true" --project $Web
dotnet user-secrets set "Smtp:Mode" "Smtp" --project $Web
dotnet user-secrets set "Smtp:FromAddress" "your-mailbox@gmail.com" --project $Web
dotnet user-secrets set "Smtp:Username" "your-mailbox@gmail.com" --project $Web
dotnet user-secrets set "Smtp:Password" "YOUR_GMAIL_APP_PASSWORD" --project $Web
dotnet user-secrets set "Email:Enabled" "true" --project $Web
dotnet user-secrets set "Email:FromAddress" "your-mailbox@gmail.com" --project $Web
dotnet user-secrets set "Email:Username" "your-mailbox@gmail.com" --project $Web
dotnet user-secrets set "Email:Password" "YOUR_GMAIL_APP_PASSWORD" --project $Web

foreach ($Project in @($Api, $Web)) {
  dotnet user-secrets set "Vapid:Enabled" "true" --project $Project
  dotnet user-secrets set "Vapid:Subject" "mailto:your-mailbox@gmail.com" --project $Project
  dotnet user-secrets set "Vapid:PublicKey" "YOUR_VAPID_PUBLIC_KEY" --project $Project
  dotnet user-secrets set "Vapid:PrivateKey" "YOUR_VAPID_PRIVATE_KEY" --project $Project
  dotnet user-secrets set "Push:Enabled" "true" --project $Project
  dotnet user-secrets set "Push:Subject" "mailto:your-mailbox@gmail.com" --project $Project
  dotnet user-secrets set "Push:PublicKey" "YOUR_VAPID_PUBLIC_KEY" --project $Project
  dotnet user-secrets set "Push:PrivateKey" "YOUR_VAPID_PRIVATE_KEY" --project $Project
}

Write-Host "Done. List keys (not values): dotnet user-secrets list --project $Api"
