# Copy to .env and fill in secrets (never commit .env).
# JIRA_* — tools/aidlc-jira.mjs — see ai/context/jira-sync.md
# PLAYWRIGHT_JIRA_* — "Playwright to Jira Config" app (e2e/jira-reporter.js)

JIRA_BASE_URL=https://vishalsworkspace-42884791.atlassian.net
JIRA_PROJECT_KEY=EDBS
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=
# Required to upload failure screenshots to EDBS-38 Attachments (Atlassian API token, not webhook token)

# Playwright Results for Jira (Atlassian Marketplace app — Jira → Apps → Playwright Configuration)
PLAYWRIGHT_JIRA_WEBHOOK_URL=
PLAYWRIGHT_JIRA_TOKEN=

# Which Jira issue receives the Playwright Results webhook (numeric id, not key)
# EDBS-38 → JIRA_ISSUE_ID=10037
JIRA_ISSUE_ID=10037
# JIRA_ISSUE_KEY=EDBS-38

# Story for rich test evidence subtask (US-001/Tests → EDBS-95)
JIRA_STORY_ID=US-001
